# ── Backend environment variables ──────────────────────────────────────────
# Copy this file to .env and fill in real values. Never commit .env.

# Application
APP_ENV=development
LOG_LEVEL=INFO

# Database (Neon Postgres connection string)
DATABASE_URL=

# LLM provider selection: groq | mistral | openrouter | fake
LLM_PROVIDER=fake

# API keys
GROQ_API_KEY=
MISTRAL_API_KEY=
OPENROUTER_API_KEY=

# Model selection (determined by Task 1 eval)
LLM_PRIMARY_MODEL=
LLM_FALLBACK_MODEL=
EMBEDDING_MODEL=mistral-embed

# CORS – comma-separated list of exact frontend origins
ALLOWED_ORIGINS=http://localhost:5173

# Upload limits
MAX_PDF_MB=5
MAX_PDF_PAGES=40
MAX_DOCS_PER_CONVERSATION=3

# Rate limits (per anon_id)
RATE_LIMIT_PER_HOUR=20
RATE_LIMIT_PER_DAY=100

# Concurrency
MAX_CONCURRENT_GENERATIONS=3

# LLM tuning
MAX_OUTPUT_TOKENS=
HISTORY_TOKEN_BUDGET=
RETRIEVAL_TOP_K=

# Storage guard
MAX_CONVERSATIONS_PER_ANON=20
MAX_MESSAGES_PER_CONVERSATION=100
RETENTION_DAYS=30

# ── Frontend environment variables ─────────────────────────────────────────
# Set at Vercel build time. Public by design (ships to the browser).
VITE_API_BASE_URL=http://localhost:8000
